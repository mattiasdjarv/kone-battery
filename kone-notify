#!/usr/bin/env python3
import os
import subprocess
import sys
import time

CACHE_FILE = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/kone_battery_live.txt"
LOW_THRESHOLD = int(os.environ.get("KONE_LOW_THRESHOLD", "20"))
POLL_INTERVAL = int(os.environ.get("KONE_POLL_INTERVAL", "30"))


def read_status():
    if not os.path.exists(CACHE_FILE):
        return None
    try:
        with open(CACHE_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def notify(message, urgent=False):
    args = [
        "notify-send",
        "-t", "5000",
        "-u", ("critical" if urgent else "normal"),
        "-a", "Kone Pro Air",
        message,
    ]
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        print("notify-send not found; install libnotify", file=sys.stderr)


def main():
    last_status = None
    low_notified = False
    charging_notified = False

    print(f"Kone notify: watching every {POLL_INTERVAL}s, low threshold {LOW_THRESHOLD}%")

    while True:
        status = read_status()
        if status and status != last_status:
            last_status = status

            if status == "Charging":
                if not charging_notified:
                    notify("Charging")
                    charging_notified = True
                low_notified = False
            elif status.endswith("%"):
                charging_notified = False
                try:
                    pct = int(status[:-1])
                except ValueError:
                    continue
                if pct < LOW_THRESHOLD:
                    if not low_notified:
                        notify(f"Battery low: {pct}%", urgent=True)
                        low_notified = True
                else:
                    low_notified = False

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
