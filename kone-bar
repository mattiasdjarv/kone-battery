#!/usr/bin/env python3
import os
import sys

CACHE_FILE = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/kone_battery_live.txt"


def read_status():
    if not os.path.exists(CACHE_FILE):
        return None
    try:
        with open(CACHE_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def main():
    status = read_status()
    if not status:
        print("--")
        return
    print(status)


if __name__ == "__main__":
    main()
