#!/usr/bin/env python3
import os
import sys

CACHE_FILE = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/kone_battery_live.txt"


def main():
    if not os.path.exists(CACHE_FILE):
        print("No data", file=sys.stderr)
        sys.exit(1)

    try:
        with open(CACHE_FILE) as f:
            status = f.read().strip()
    except OSError as e:
        print(f"Error reading cache: {e}", file=sys.stderr)
        sys.exit(1)

    if not status:
        print("No data", file=sys.stderr)
        sys.exit(1)

    print(status)


if __name__ == "__main__":
    main()
